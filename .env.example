# ============================================================
#  EJEMPLO DE LLAVES — panel multimedia (MediaPilot)
# ============================================================
#  Este archivo es SOLO un ejemplo. NUNCA lo llenes con claves reales
#  ni lo subas al repo.
#
#  Uso:
#    1. Copiarlo como  .env
#    2. Rellenar solo lo que vayas a usar (todo es opcional por módulo)
#    3. .env esta en .gitignore — no se versiona
#
#  En PowerShell para cargarlo en la sesion:
#    Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } |
#      ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(),$v.Trim()) }
# ============================================================


# ------------------------------------------------------------
# 1) APLICACION
# ------------------------------------------------------------
# Clave para firmar sesiones / cookies. Generar una aleatoria larga.
APP_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
APP_URL=http://localhost:3000
APP_ENTORNO=desarrollo            # desarrollo | produccion

# Carpeta donde se guardan los archivos subidos (videos, fotos, audios)
MEDIA_DIR=./media
# Limite de subida por archivo, en MB
MAX_UPLOAD_MB=500


# ------------------------------------------------------------
# 2) BASE DE DATOS
# ------------------------------------------------------------
# Desarrollo: SQLite no necesita nada mas
DATABASE_URL=file:./data/panel.db

# Produccion (Postgres) — descomentar y borrar la de arriba
# DATABASE_URL=postgresql://usuario:password@localhost:5432/panel


# ------------------------------------------------------------
# 3) YOUTUBE  (Google Cloud Console -> APIs & Services -> Credentials)
# ------------------------------------------------------------
# Necesitas una app OAuth2 de tipo "Desktop" o "Web".
# API a habilitar: YouTube Data API v3
# Scopes: youtube.upload, youtube.readonly, youtube.force-ssl
YOUTUBE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# Se obtiene despues de autorizar (refresh token de larga duracion).
# En este repo los tokens viven en archivos aparte, nunca en el codigo:
#   .youtube-token-FURIA.json     (Furia Nation)
#   .youtube-token-FRUTI.json     (FrutiReels)
YOUTUBE_REFRESH_TOKEN=

# Solo lectura, para metricas sin OAuth
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ------------------------------------------------------------
# 4) META — Facebook Pages + Instagram
#    (developers.facebook.com -> App -> Messenger/Instagram Graph API)
# ------------------------------------------------------------
# La app debe tener: pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, instagram_manage_comments
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# Token de usuario de larga duracion (no caduca segun debug_token)
META_USER_TOKEN=EAAG...

# IDs de las cuentas
FACEBOOK_PAGE_ID=000000000000000
INSTAGRAM_BUSINESS_ID=17841400000000000


# ------------------------------------------------------------
# 5) TIKTOK
#    (developers.tiktok.com -> Content Posting API)
# ------------------------------------------------------------
# OJO: sin app auditada, TikTok solo permite subir como PRIVADO
# (SELF_ONLY) o a borradores. Publicar en publico requiere auditoria.
TIKTOK_CLIENT_KEY=awxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback


# ------------------------------------------------------------
# 6) TELEGRAM (avisos y recordatorios)
#    @BotFather -> /newbot  para el token
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000


# ------------------------------------------------------------
# 7) FUENTES DE IMAGEN Y VIDEO (licencia libre)
# ------------------------------------------------------------
PIXABAY_KEY=00000000-0000000000000000        # pixabay.com/api/docs
PEXELS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # pexels.com/api
UNSPLASH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # unsplash.com/developers

# Freesound: usar SOLO licencias CC0 o CC-BY (nunca CC-BY-NC)
FREESOUND_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NASA / ESA: gratis, requiere clave en api.nasa.gov
NASA_KEY=DEMO_KEY


# ------------------------------------------------------------
# 8) INTELIGENCIA ARTIFICIAL
# ------------------------------------------------------------
# Google AI Studio (Gemini): texto, TTS y Veo
#   aistudio.google.com -> Get API key
#   OJO: capa gratis = ~10 requests/dia POR MODELO en TTS
GOOGLE_AI_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter: modelo principal del chat del panel
# deepseek/deepseek-v4.1-flash-1017 = DeepSeek V4.1 Flash 1017
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODELO=deepseek/deepseek-v4.1-flash-1017

# Runway (video IA) — 1 credito = $0.01
RUNWAY_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# 9) VOZ
# ------------------------------------------------------------
# edge-tts no necesita clave (gratis, sin registro)
# Voz por defecto recomendada:
TTS_VOZ_EDGE=es-MX-JorgeNeural
# Gemini TTS (necesita GOOGLE_AI_KEY arriba)
TTS_VOZ_GEMINI=Orus
TTS_MODELO_GEMINI=gemini-3.8-flash-lite-tts


# ------------------------------------------------------------
# 10) OPCIONALES
# ------------------------------------------------------------
# Almacenamiento compatible con S3 (si se sale de disco local)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Redis para colas de render (cuando haya varios videos a la vez)
# REDIS_URL=redis://localhost:6379
